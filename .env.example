# Copy to .env and adjust. .env is gitignored — never commit real credentials.

BASE_URL=http://localhost:3000

# Admin account seeded by `npm run gitea:setup`.
GITEA_ADMIN_USER=qaadmin
GITEA_ADMIN_PASSWORD=QaAdmin#2026

# Where the local Gitea instance (binary + SQLite data) lives.
# Keep it out of any path containing spaces or parentheses.
GITEA_HOME=C:/Users/bidip/.gitea-aut
